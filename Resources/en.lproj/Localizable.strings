/* Explanation shown before macOS asks for the Accessibility permission (Paste Directly) */
"directPaste.permission.title" = "Allow Klemmi to paste directly?";
"directPaste.permission.message" = "With “Paste Directly” on, ↩ in the overlay puts the entry on the clipboard and then sends ⌘V to the app you were working in. macOS only allows this with the Accessibility permission.\n\nNext, allow Klemmi under System Settings ▸ Privacy & Security ▸ Accessibility. Until then, ↩ only copies, as before.\n\nTo take this back later, turn off “Paste Directly” in Klemmi’s menu or remove Klemmi from the Accessibility list in System Settings.";
"directPaste.permission.continue" = "Continue";
"directPaste.permission.cancel" = "Cancel";

